{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "."
      ],
      "env": {
        "DO_NOT_TRACK": "1",
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "shadcn": {
      "command": "pnpm",
      "args": [
        "dlx",
        "shadcn@4.23.0",
        "mcp"
      ],
      "env": {
        "DO_NOT_TRACK": "1"
      }
    }
  }
}
