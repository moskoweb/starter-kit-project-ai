# Runtime database connection (DML role vibe_starter_app, NOSUPERUSER)
DATABASE_URL=postgresql://vibe_starter_app:change_me@127.0.0.1:5432/vibe_starter

# Migration database connection (DDL role vibe_starter_owner, NOSUPERUSER, required for migrations)
MIGRATION_DATABASE_URL=postgresql://vibe_starter_owner:change_me@127.0.0.1:5432/vibe_starter

# Server configuration
PORT=3000
NODE_ENV=development

# Identity is validated only when auth is used. Generate locally: openssl rand -base64 32
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
IDENTITY_PROFILE=hybrid
# Organization topology is independent of IDENTITY_PROFILE. See docs/SINGLE-TENANT.md.
ORGANIZATION_MODE=multi
# Required UUID of an existing organization when ORGANIZATION_MODE=single.
# SINGLE_ORGANIZATION_ID=

# Optional Google sign-in. Client ID/secret required only when GOOGLE_ENABLED=true.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Choose exactly one provider. No automatic fallback. SMTP example needs no account.
EMAIL_PROVIDER=smtp
EMAIL_FROM='Vibe Starter <no-reply@example.test>'
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=

# Explicit admin provisioning (password is read from stdin, never argv).
# ADMIN_EMAIL=
# ADMIN_NAME=

# Optional S3-compatible storage. Required only when enabled; use private buckets.
STORAGE_ENABLED=false
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional AI provider. Never expose these values through NEXT_PUBLIC_*.
AI_ENABLED=false
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# Optional durable worker; provisioning uses separate migration credentials.
JOBS_ENABLED=false
# JOBS_MIGRATION_DATABASE_URL=
# JOBS_RUNTIME_ROLE=
# WORKER_DATABASE_URL=
# EVENTS_PROVISION_DATABASE_URL=
# EVENTS_WORKER_ROLE=
# S3_PUBLIC_UPLOAD_ORIGIN=https://your-private-bucket.example
# AI_MAX_OUTPUT_TOKENS=1024
# AI_DAILY_MAX_REQUESTS=30
# AI_DAILY_MAX_OUTPUT_TOKENS=20000
# Generate independently when rate-limited integrations are enabled.
# RATE_LIMIT_SECRET=

WEBHOOKS_INBOUND_ENABLED=false
WEBHOOKS_OUTBOUND_ENABLED=false
# WEBHOOK_INBOUND_ENDPOINT_ID=
# WEBHOOK_INBOUND_SECRET=
# WEBHOOK_OUTBOUND_URL=
# WEBHOOK_OUTBOUND_SECRET=
# WEBHOOK_OUTBOUND_ALLOWED_HOSTS=

NEXT_PUBLIC_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_SITE_URL=https://your-application.example
OTEL_LOG_EXPORT_ENABLED=false
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# Public website (Astro): public values only, never API secrets.
SITE_URL=http://127.0.0.1:4321
PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional browser installation and push; never cache authenticated data.
PWA_ENABLED=false
PUSH_ENABLED=false
# PUSH_VAPID_SUBJECT=mailto:operator@example.test
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
