{
  "name": "@vibe/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./events-schema": "./src/events-schema.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "tsx ../cli/src/generate-migrations.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:rate-limit-cleanup": "tsx src/rate-limit-cleanup.ts"
  },
  "dependencies": {
    "@vibe/config": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "5.9.3"
  }
}
