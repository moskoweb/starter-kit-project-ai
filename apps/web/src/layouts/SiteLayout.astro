---
import "../styles/global.css";
import { appUrl } from "../lib/app-url";
import { productName, routes, type Lang } from "../lib/site";
interface Props { title: string; description: string; lang?: Lang }
const { title, description, lang = "pt-BR" } = Astro.props as Props;
const english = lang === "en";
const other: Lang = english ? "pt-BR" : "en";
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const route = Object.values(routes).find((r) => r[lang] === path);
const switchPath = route ? route[other] : routes.home[other];
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: productName, url: Astro.site?.href }).replace(/</g, "\\u003c");
const t = english
  ? { skip: "Skip to content", nav: "Main navigation", guide: "Setup guide", login: "Sign in", signup: "Create account", lang: "Português", theme: "Toggle theme", themeLabel: "Theme", legal: "Legal", privacy: "Privacy policy", terms: "Terms of use", cookies: "Cookie policy" }
  : { skip: "Pular para conteúdo", nav: "Navegação principal", guide: "Começar", login: "Entrar", signup: "Criar conta", lang: "English", theme: "Alternar tema", themeLabel: "Tema", legal: "Legal", privacy: "Política de privacidade", terms: "Termos de uso", cookies: "Política de cookies" };
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {route && <link rel="alternate" hreflang={lang} href={canonical} />}
    {route && <link rel="alternate" hreflang={other} href={new URL(route[other], Astro.site)} />}
    {route && <link rel="alternate" hreflang="x-default" href={new URL(route["pt-BR"], Astro.site)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={english ? "en_US" : "pt_BR"} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header><nav class="wrap" aria-label={t.nav}>
      <a class="brand" href={routes.home[lang]}>{productName}</a>
      <a href={routes.gettingStarted[lang]}>{t.guide}</a>
      <a href={`${appUrl}/login`}>{t.login}</a>
      <a href={switchPath} hreflang={other} lang={other}>{t.lang}</a>
      <button type="button" id="theme-toggle" aria-label={t.theme} aria-pressed="false">{t.themeLabel}</button>
    </nav></header>
    <main id="main" class="wrap"><slot /></main>
    <footer><div class="wrap">
      <span>© {new Date().getFullYear()} {productName}</span>
      <nav aria-label={t.legal} class="footer-links">
        <a href={routes.privacy[lang]}>{t.privacy}</a>
        <a href={routes.terms[lang]}>{t.terms}</a>
        <a href={routes.cookies[lang]}>{t.cookies}</a>
        <a href={routes.gettingStarted[lang]}>{t.guide}</a>
      </nav>
    </div></footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const root = document.documentElement;
      let saved: string | null = null;
      try { saved = localStorage.getItem("theme"); } catch {}
      if (saved === "light" || saved === "dark") root.dataset.theme = saved;
      const update = () => button?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
      update();
      button?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        update();
      });
    </script>
  </body>
</html>
